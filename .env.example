# Copy to `.env` to run the engine's specs against a scratch MySQL database.
#
# The suites create and drop their own tables in the database below, so point it at a database you can throw away —
# never at one that holds anything you care about.

NODE_ENV=test
LOG_LEVEL=silent

# The adapter's database session store needs a key that AdonisJS accepts (32+ characters).
APP_KEY=orm-test-app-key-that-is-long-enough-to-pass-validation

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=orm_test
