{
    "name": "@mergehez/ormvan",
    "version": "0.1.0",
    "description": "The framework-agnostic raw-SQL ORM engine: models, builders, hooks and soft delete, over mysql2, with knex-driven migrations.",
    "license": "MIT",
    "author": "mergehez <argesozdogan@gmail.com>",
    "homepage": "https://github.com/mergehez/ormvan#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mergehez/ormvan.git",
        "directory": "packages/core"
    },
    "bugs": {
        "url": "https://github.com/mergehez/ormvan/issues"
    },
    "keywords": [
        "orm",
        "sql",
        "mysql",
        "mysql2",
        "knex",
        "query-builder",
        "soft-delete",
        "migrations",
        "typescript"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "engines": {
        "node": ">=20"
    },
    "files": [
        "src",
        "dist"
    ],
    "exports": {
        ".": {
            "development": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*": {
            "development": "./src/*.ts",
            "types": "./dist/*.d.ts",
            "default": "./dist/*.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json",
        "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
        "test": "bun --env-file=../../.env bin/test.ts",
        "typecheck": "tsc --noEmit",
        "tsc": "tsc --noEmit",
        "prepublishOnly": "bun run build"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "knex": "^3.3.0",
        "mysql2": "^3.24.3"
    },
    "peerDependenciesMeta": {
        "knex": {
            "optional": true
        }
    },
    "devDependencies": {
        "@japa/assert": "^4.2.0",
        "@japa/expect-type": "^2.0.4",
        "@japa/runner": "^5.3.0",
        "@types/node": "^26.6.4",
        "knex": "^3.3.0",
        "mysql2": "^3.24.5",
        "typescript": "^7.1.0-dev.20261008.1"
    }
}
